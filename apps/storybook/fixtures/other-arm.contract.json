{
 "format": "1.0",
 "arm": "a second contract over arm 1's Storybook, shaped as another arm's would be (#4436 fixture)",
 "components": {
  "button": {
   "root": ".p3-button",
   "parts": {
    "container": "",
    "container/leadingVisual": ".p3-button__leading-visual",
    "container/spinner": ".p3-button__spinner",
    "container/label": ".p3-button__label",
    "container/trailingVisual": ".p3-button__trailing-visual"
   },
   "focusRing": {
    "drawn": "outline"
   },
   "variant": {
    "cases": {}
   }
  },
  "text-field": {
   "root": ".p3-text-field",
   "parts": {
    "container": "",
    "container/label": ":scope > .p3-field-label",
    "container/control": ":scope > .p3-text-field__control",
    "container/control/content": ":scope > .p3-text-field__control > .p3-text-field__content",
    "container/control/content/leadingVisual": ".p3-text-field__content > .p3-text-field__leading-visual",
    "container/control/content/entry": ".p3-text-field__content > .p3-text-field__entry",
    "container/control/content/entry/placeholder": {
     "unboxed": "the native input's placeholder text, drawn inside the entry"
    },
    "container/control/content/entry/value": {
     "unboxed": "the native input's value text, drawn inside the entry"
    },
    "container/control/content/entry/caret": {
     "unboxed": "the browser's own caret"
    },
    "container/control/content/entry/caretEnd": {
     "unboxed": "the browser's own caret"
    },
    "container/control/trailingVisual": ":scope > .p3-text-field__control > .p3-text-field__trailing-visual",
    "container/message": ":scope > .p3-field-message"
   },
   "focusRing": {
    "drawn": "none",
    "why": "the field shows focus with its control's border, as its anatomy does"
   },
   "variant": {
    "cases": {
     "error": {
      "validation": "error"
     }
    }
   }
  }
 },
 "forms": {
